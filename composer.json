{
    "name": "thanasis-oob/mysql-aes-encrypt",
    "type": "library",
    "description": "Laravel MySql AES Encrypt/Decrypt",
    "keywords": ["laravel","mysql", "aes", "encrypt"],
    "homepage": "https://github.com/thanasis-oob/mysql-aes-encrypt",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Thanous K",
            "email": "tkoutsou@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "illuminate/support": "^11.0",
        "illuminate/database": "^11.0"
    },
        "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "mrzainulabideen\\AESEncrypt\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "mrzainulabideen\\AESEncrypt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "mrzainulabideen\\AESEncrypt\\AesEncryptServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
